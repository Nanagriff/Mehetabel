---
import content from '../content/content.json';
const { owner, nav } = content;
const name = owner.useBusinessName && owner.businessName ? owner.businessName : owner.name;
// On a phone the bar shows the first name (or the business name) so nothing is cut off.
const shortName = owner.useBusinessName && owner.businessName ? owner.businessName : owner.firstName && !/TODO/.test(owner.firstName) ? owner.firstName : name;
---
<header class="topbar">
  <a class="skip-link" href="#work">Skip to my work</a>
  <div class="topbar-in">
    <a class="brand serif" href="#hello" aria-label={name}><span class="brand-full">{name}</span><span class="brand-short" aria-hidden="true">{shortName}</span></a>
    <nav aria-label="Sections">
      <ul>
        {nav.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="topbar-actions">
      <a class="btn btn-small" href={owner.cv} download>{nav.cvLabel}</a>
      <a class="btn btn-small btn-fill" href="#contact">{nav.contactLabel}</a>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--topbar-h);
    background: var(--panel);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--rule);
    overflow: clip;
  }
  .topbar-in {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-inline: var(--gutter);
    max-width: 80rem;
    margin-inline: auto;
  }
  .brand {
    font-size: 1.25rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    font-variation-settings: 'opsz' 24;
  }
  .brand-short {
    display: none;
  }
  nav {
    margin-inline: auto;
  }
  nav ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .topbar-actions {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 30;
    padding: 0.6em 1em;
    background: var(--ink);
    color: var(--bg);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  .skip-link:focus {
    top: 0.6rem;
  }
  @media (max-width: 44rem) {
    nav {
      display: none;
    }
    .brand {
      font-size: 1.1rem;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 44vw;
    }
    .brand-full {
      display: none;
    }
    .brand-short {
      display: inline;
    }
    .topbar-in {
      gap: 0.75rem;
    }
  }
</style>
