---
// The persistent grain. One canvas, fixed behind everything, driven by scroll. Purely additive:
// without JavaScript it is an empty element and the page reads the same.
---
<div class="stage-mask" aria-hidden="true"></div>
<canvas id="grain-canvas" class="grain-canvas" aria-hidden="true"></canvas>

<style>
  .grain-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    /* the large viewport, so a phone's collapsing address bar never resizes the canvas */
    height: 100vh;
    height: 100lvh;
    z-index: 0;
    pointer-events: none;
    display: none;
  }
  html.js .grain-canvas {
    display: block;
    transition: opacity 0.6s var(--ease-soft);
  }
  html.js :global(main) {
    position: relative;
    z-index: 1;
  }
  .stage-mask {
    display: none;
  }
  @media (max-width: 59.99rem) {
    /* The stage: a strip under the top bar that the story's text slides beneath while the grain plays
       on top of it. JS adds .stage-on to <html> through the story beats and removes it after. */
    html.js .stage-mask {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: calc(var(--topbar-h) + var(--stage-h));
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(to bottom, var(--bg) 0%, var(--bg) 86%, transparent 100%);
      opacity: 0;
      transition: opacity 0.5s var(--ease-soft);
    }
    html.stage-on .stage-mask {
      opacity: 1;
    }
    html.stage-on .grain-canvas {
      z-index: 3;
    }
    html.stage-done .grain-canvas {
      opacity: 0;
    }
  }
</style>
