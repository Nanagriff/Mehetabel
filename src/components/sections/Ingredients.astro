---
import Narrative from '../Narrative.astro';
import content from '../../content/content.json';
const s = content.sections.ingredients;
const items = content.ingredients;
---
<Narrative id="ingredients" s={s} stage="cold" keyIndex={3}>
  <ul class="ingredients reveal" data-ingredients>
    {
      items.map((it, i) => (
        <li>
          <button
            class="ing"
            type="button"
            aria-expanded="false"
            aria-controls={`ing-${i}`}
            data-ingredient={i}
            style={`--ing: ${it.colour}`}
          >
            <span class="swatch" aria-hidden="true" />
            <span class="ing-name">{it.name}</span>
            <span class="ing-stands">{it.stands}</span>
          </button>
          <div id={`ing-${i}`} class={`ing-note ${/\[TODO/.test(it.note) ? 'todo' : ''}`}>
            <p>{it.note}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Narrative>

<style>
  .ingredients {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 40rem;
  }
  .ingredients li {
    display: contents;
  }
  .ing {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.5em 0.95em 0.5em 0.6em;
    border-radius: 999px;
    border: 1.5px solid var(--rule);
    background: var(--panel);
    font-size: 1rem;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .ing:hover,
  .ing[aria-expanded='true'] {
    border-color: var(--ing);
  }
  .swatch {
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    background: var(--ing);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  .ing-name {
    font-weight: 600;
  }
  .ing-stands {
    color: var(--ink-soft);
  }
  .ing-stands::before {
    content: '·';
    margin-right: 0.5em;
  }
  .ing-note {
    flex-basis: 100%;
    max-width: var(--col);
    padding: 0.75rem 0 0.25rem;
    font-size: 1.0625rem;
  }
  html.js .ing-note:not(.open) {
    display: none;
  }
  html:not(.js) .ing-note {
    order: 1;
  }
</style>
