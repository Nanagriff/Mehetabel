---
import { readFileSync } from 'node:fs';
import { bold } from '../../utils/markup.js';
import content from '../../content/content.json';
const s = content.sections.secret;
let svg = '';
try {
  svg = readFileSync(`public${s.handwriting}`, 'utf8')
    .replace(/<\?xml[^>]*>/, '')
    .replace('<svg ', '<svg class="handwriting" data-handwriting aria-hidden="true" focusable="false" ');
} catch {
  svg = '';
}
const todo = /\[TODO/.test(s.paragraph) ? 'todo' : '';
---
<section id="secret" class="section secret stage-glow" data-key="5" aria-labelledby="secret-h">
  <div class="secret-pin">
    <div class="wrap">
      <p class="label"><b>{s.number}</b>{s.label}</p>
      <h2 id="secret-h" set:html={bold(s.headline)} />
      <div class="love" role="img" aria-label={s.handwritingAlt}>
        <Fragment set:html={svg} />
      </div>
      <p class={`secret-text ${todo}`} data-secret-text>{s.paragraph}</p>
    </div>
  </div>
</section>

<style>
  .secret {
    min-height: 220vh;
    min-height: 220svh;
    padding: 0;
  }
  .secret-pin {
    position: sticky;
    top: var(--topbar-h);
    height: calc(100vh - var(--topbar-h));
    height: calc(100svh - var(--topbar-h));
    display: grid;
    align-items: center;
  }
  .secret h2 {
    max-width: 16ch;
  }
  .love {
    margin: 2rem 0 1.5rem;
    width: min(22rem, 70vw);
    color: var(--jollof);
  }
  .love :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .secret-text {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.6rem);
    line-height: 1.5;
    font-variation-settings: 'opsz' 18;
    max-width: 52ch;
  }
  html.js .secret-text {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 1.6s var(--ease-soft), transform 1.6s var(--ease-soft);
  }
  html.js .secret-text.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .secret-text {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 59.99rem) {
    .secret {
      min-height: 180vh;
      min-height: 180svh;
    }
    /* the text sits under the stage, where the pot is, and stays while the paragraph writes itself */
    .secret-pin {
      align-items: end;
      padding-top: var(--stage-h);
      padding-bottom: 5vh;
    }
    .love {
      width: min(11rem, 40vw);
      margin: 1rem 0 0.75rem;
    }
    .secret-text {
      font-size: 1.125rem;
    }
  }
</style>
