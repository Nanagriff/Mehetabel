---
import Narrative from '../Narrative.astro';
import Pic from '../Pic.astro';
import content from '../../content/content.json';
const s = content.sections.pot;
---
<Narrative id="pot" s={s} stage="warm" keyIndex={6}>
  <div class="scrub reveal" slot="after">
    <label class="scrub-label" for="cook-range">Scrub the timeline</label>
    <input id="cook-range" class="scrub-range" type="range" min="0" max="100" value="0" step="1" data-cook aria-valuetext="Raw" />
    <ol class="scrub-marks" aria-hidden="true">
      {s.scrubLabels.map((l) => <li>{l}</li>)}
    </ol>
  </div>
</Narrative>
<figure class="bleed">
  <Pic src={s.photo.src} alt={s.photo.alt} width={s.photo.width} height={s.photo.height} sizes="100vw" />
</figure>

<style>
  .scrub {
    margin-top: 1.5rem;
    max-width: 24rem;
  }
  html:not(.js) .scrub {
    display: none;
  }
  .scrub-label {
    display: block;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }
  .scrub-range {
    width: 100%;
    accent-color: var(--jollof);
  }
  .scrub-marks {
    display: flex;
    justify-content: space-between;
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
</style>
