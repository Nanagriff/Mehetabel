---
import Narrative from '../Narrative.astro';
import Pic from '../Pic.astro';
import content from '../../content/content.json';
const s = content.sections.work;
const projects = content.projects;
const found = content.play.recipe.ingredients.find((i) => i.hidingPlace === 'card');
const todo = (t) => (/\[TODO/.test(t ?? '') ? 'todo' : '');
---
<Narrative id="work" s={s} stage="cool" keyIndex={10} class="work" />
<section class="section cards-section stage-cool" aria-label="Projects">
  <div class="wrap">
    <ul class="cards" data-cards>
      {
        projects.map((p) => (
          <li>
            <article class="card reveal" data-card={p.id} data-skills={p.skills.join(' ')}>
              <div class="card-media">
                <Pic src={p.images[0].src} alt={p.images[0].alt} width={p.images[0].width} height={p.images[0].height} focus={p.images[0].focus} sizes="(min-width: 60rem) 40vw, 100vw" />
              </div>
              <div class="card-head">
                <p class="label"><b>{p.kind}</b>{p.date}</p>
                <h3 class={todo(p.name)}>{p.name}</h3>
                <p class={`card-meta quiet ${todo(p.role)}`}>{p.role} · {p.scale}</p>
                <button class="btn btn-small card-toggle" type="button" aria-expanded="false" aria-controls={`card-${p.id}`}>
                  <span class="when-closed">Open</span><span class="when-open">Close</span>
                </button>
              </div>
              <div class="card-body" id={`card-${p.id}`}>
                <p class={todo(p.what)}>{p.what}</p>
                <p class={`outcome ${todo(p.outcome)}`}><strong>Outcome.</strong> {p.outcome}</p>
                {p.link && <p><a class="btn btn-small" href={p.link.href} target="_blank" rel="noopener">{p.link.label}</a></p>}
                <p class="card-skills quiet">Used: {p.skills.map((id) => {
                  const sk = [...content.skills.kitchen, ...content.skills.studio].find((x) => x.id === id);
                  return sk ? sk.label : id;
                }).join(', ')}</p>
                {p.images.slice(1).map((im) => (
                  <Pic src={im.src} alt={im.alt} width={im.width} height={im.height} focus={im.focus} sizes="(min-width: 60rem) 40vw, 100vw" class="card-extra" />
                ))}
                {p.hidesIngredient && found && (
                  <button class="btn btn-small" type="button" data-find={found.id}>
                    There's a grain tucked in this card. Take it.
                  </button>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cards-section {
    padding-top: 0;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: var(--panel);
    transition: opacity 0.3s, border-color 0.3s, transform 0.3s var(--ease-out);
  }
  .card.dim {
    opacity: 0.35;
  }
  .card.lit {
    border-color: var(--jollof);
  }
  .card.open {
    grid-column: 1 / -1;
  }
  .card-media {
    border-radius: 0.5rem;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--ivory-deep);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-head .label {
    margin-bottom: 0.5rem;
  }
  .card-meta {
    font-size: 1rem;
    margin: 0.35rem 0 0.75rem;
  }
  html:not(.js) .card-toggle {
    display: none;
  }
  .card-toggle .when-open {
    display: none;
  }
  .card-toggle[aria-expanded='true'] .when-open {
    display: inline;
  }
  .card-toggle[aria-expanded='true'] .when-closed {
    display: none;
  }
  html.js .card:not(.open) .card-body {
    display: none;
  }
  .card-body {
    font-size: 1.0625rem;
    max-width: var(--col);
  }
  .card-body p {
    margin-bottom: 0.75em;
  }
  .card-skills {
    font-size: 0.9375rem;
  }
  .card-extra {
    margin-top: 0.75rem;
    border-radius: 0.5rem;
  }
</style>
